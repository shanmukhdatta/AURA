      "surface_id": "sqlite.users",
      "predicate": {
        "operator": "eq",
        "fact_key": "sql.checker_0",
        "expected": 1
      },
      "required_complete_coverage": []
    },
    {
      "id": "checker_1",
      "description": "SQL state check: SELECT active FROM users WHERE id=2",
      "category": "outcome",
      "surface_id": "sqlite.users",
      "predicate": {
        "operator": "eq",
        "fact_key": "sql.checker_1",
        "expected": 1
      },
      "required_complete_coverage": []
    },
    {
      "id": "checker_2",
      "description": "Agent answer requirement: {'kind': 'answer', 'any_of': ['2', 'two']}",
      "category": "outcome",
      "surface_id": "trace.tools",
      "predicate": {
        "operator": "eq",
        "fact_key": "answer.text_2",
        "expected": "2"
